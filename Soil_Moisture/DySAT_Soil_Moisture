    "WINDOW = 60\n",
    "\n",
    "node_scalers = {}\n",
    "train_scaled_g, test_scaled_g = {}, {}\n",
    "for col in graph_nodes:\n",
    "    sc = MinMaxScaler()\n",
    "    train_scaled_g[col] = sc.fit_transform(train_df[[col]]).flatten()\n",
    "    test_scaled_g[col] = sc.transform(test_df[[col]]).flatten()\n",
