s":[{"name":"stdout","output_type":"stream","text":["Using device: cpu\n"]}],"source":["from torch_geometric.nn import GATConv\n","\n","device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","print(f\"Using device: {device}\")\n","\n","edge_index_dev = edge_index.to(device)\n","edge_weight_dev = edge_weight.to(device)\n","loss_fn = nn.MSELoss()\n","\n","X_train_t = torch.tensor(X_train_g, dtype=torch.float32)\n","y_train_t = torch.tensor(y_train_g, dtype=torch.float32).unsqueeze(-1)\n","X_test_t = torch.tensor(X_test_g, dtype=torch.float32)"]},{"cell_type":"markdown","id":"51c06fe9","metadata":{"papermill":{"duration":0.003759,"end_time":"2026-08-14T18:29:24.743627+00:00","exception":false,"start_time":"2026-08-14T18:29:24.739868+00:00","status":"completed"},"tags":[]},"source":["## Subsampling — this model's per-sample loop is expensive\n"]},{"cell_type":"code","execution_count":6,"id":"3bf5ac7b","metadata":{"execution":{"iopub.execute_input":"2026-08-14T18:29:24.753676Z","iopub.status.busy":"2026-08-14T18:29:24.752915Z","iopub.status.idle":"2026-08-14T18:29:24.81248Z","shell.execute_reply":"2026-08-14T18:29:24.811537Z"},"papermill":{"duration":0.067124,"end_time":"2026-08-14T18:29:24.814664+00:00","exception":false,"start_time":"2026-08-14T18:29:24.74754+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Train subsample: 33292  Test subsample: 1500  Batches/epoch: 520\n"]}],"source":["SUBSAMPLE_SIZE = 36000  \n","\n","subsample_idx = np.random.RandomState(42).choice(len(X_train_t), size=min(SUBSAMPLE_SIZE, len(X_train_t)), replace=False)\n","X_train_sub = X_train_t[subsample_idx]\n","y_train_sub = y_train_t[subsample_idx]\n","\n","test_subsample_idx = np.random.RandomState(43).choice(len(X_test_t), size=min(1500, len(X_test_t)), replace=False)\n","X_test_sub = X_test_t[test_subsample_idx]\n","y_test_sub_true = target_scaler_g.inverse_transform(y_test_g[test_subsample_idx].reshape(-1, 1)).flatten()\n","\n","sub_batch_size = 64\n","n_sub_batches = len(X_train_sub) // sub_batch_size\n","print(f\"Train subsample: {len(X_train_sub)}  Test subsample: {len(X_test_sub)}  Batches/epoch: {n_sub_batches}\")"]},{"cell_type":"markdown","id":"c2e2caf5","metadata":{"papermill":{"duration":0.003824,"end_time":"2026-08-14T18:29:24.822402+00:00","exception":false,"start_time":"2026-08-14T18:29:24.818578+00:00","status":"completed"},"tags":[]},"source":["## DySAT-Inspired Model — real embedding dimension, gradient clipping\n","\n"]},{"cell_type":"code","execution_count":7,"id":"e9460533","metadata":{"execution":{"iopub.execute_input":"2026-08-14T18:29:24.832257Z","iopub.status.busy":"2026-08-14T18:29:24.831832Z","iopub.status.idle":"2026-08-14T18:29:24.842808Z","shell.execute_reply":"2026-08-14T18:29:24.841669Z"},"papermill":{"duration":0.018219,"end_time":"2026-08-14T18:29:24.844844+00:00","exception":false,"start_time":"2026-08-14T18:29:24.826625+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["DySAT-inspired model class defined.\n"]}],"source":["class DySATInspired(nn.Module):\n","    def __init__(self, window, hidden_channels=16, n_heads=2, d_model=16):\n","        super().__init__()\n","        self.input_proj = nn.Linear(1, d_model)\n","        encoder_layer = nn.TransformerEncoderLayer(d_model=d_model, nhead=2, dim_feedforward=64, batch_first=True, dropout=0.1)\n","        self.temporal_attn = nn.TransformerEncoder(encoder_layer, num_layers=1)\n","        self.temporal_proj = nn.Linear(d_model * window, hidden_channels)\n","        self.gat = GATConv(hidden_channels, hidden_channels, heads=n_heads, edge_dim=1)\n","        self.readout = nn.Linear(hidden_channels * n_heads * n_nodes, 1)\n","\n","    def forward(self, x, edge_index, edge_weight):\n","        edge_attr = edge_weight.unsqueeze(-1)\n","        outs = []\n","        for b in range(x.shape[0]):\n","            xb = x[b].unsqueeze(-1)                     # [n_nodes, window, 1]\n","            xb_proj = self.input_proj(xb)                # [n_nodes, window, d_model]\n","            temporal_out = self.temporal_attn(xb_proj)   # [n_nodes, window, d_model]\n","            temporal_flat = temporal_out.reshape(x.shape[1], -1)\n","            node_feats = F.relu(self.temporal_proj(temporal_flat))\n","            h = F.elu(self.gat(node_feats, edge_index, edge_attr))\n","            outs.append(h.flatten())\n","        return self.readout(torch.stack(outs))\n","\n","print(\"DySAT-inspired model class defined.\")"]},{"cell_type":"markdown","id":"729b8ff1","metadata":{"papermill":{"duration":0.003843,"end_time":"2026-08-14T18:29:24.852609+00:00","exception":false,"start_time":"2026-08-14T18:29:24.848766+00:00","status":"completed"},"tags":[]},"source":["## Extended Training — watch the loss curve\n"]},{"cell_type":"code","execution_count":8,"id":"725f13e8","metadata":{"execution":{"iopub.execute_input":"2026-08-14T18:29:24.863576Z","iopub.status.busy":"2026-08-14T18:29:24.862588Z","iopub.status.idle":"2026-08-14T21:29:48.081708Z","shell.execute_reply":"2026-08-14T21:29:48.080494Z"},"papermill":{"duration":10823.237068,"end_time":"2026-08-14T21:29:48.093644+00:00","exception":false,"start_time":"2026-08-14T18:29:24.856576+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Epoch   1/50: loss=0.009134\n","Epoch   2/50: loss=0.001464\n","Epoch   3/50: loss=0.001269\n","Epoch   4/50: loss=0.001118\n","Epoch   5/50: loss=0.001096\n","Epoch   6/50: loss=0.000989\n","Epoch   7/50: loss=0.000937\n","Epoch   8/50: loss=0.000949\n","Epoch   9/50: loss=0.000826\n","Epoch  10/50: loss=0.000777\n","Epoch  11/50: loss=0.000759\n","Epoch  12/50: loss=0.000668\n","Epoch  13/50: loss=0.000685\n","Epoch  14/50: loss=0.000645\n","Epoch  15/50: loss=0.000610\n","Epoch  16/50: loss=0.000572\n","Epoch  17/50: loss=0.000551\n","Epoch  18/50: loss=0.000558\n","Epoch  19/50: loss=0.000524\n","Epoch  20/50